{
  "name": "loop-first-try",
  "schema": {
    "type": "object",
    "required": [
      "age"
    ],
    "properties": {
      "age": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "request": {
    "messages": [
      {
        "role": "user",
        "content": "How old?"
      }
    ]
  },
  "setup": {
