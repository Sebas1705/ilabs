{
  "name": "fallback-invalid-stops",
  "setup": {
    "kind": "fallback"
  },
  "providers": [
    {
      "id": "a",
      "script": [
        {
          "error": {
            "kind": "invalid_output"
          }
        }
      ]
    },
    {
      "id": "b",
      "script": [
        {
          "response": "from b"
        }
      ]
    }
  ],
  "request": {
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
